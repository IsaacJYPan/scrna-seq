# Public website demo for the 2-OCPU / 12-GB ARM64 free-tier profile.
# Copy outside the repository as deploy/demo-free-tier.env, chmod 600, and
# replace every change-me value. Never reuse private-deployment credentials.
PUBLIC_HOST=demo.example.org
FRONTEND_ORIGIN=https://demo.example.org
WEB_PORT=3001
TRUST_PROXY_HOPS=1
COOKIE_SAMESITE=Lax

SESSION_SECRET=change-me-64-lowercase-hex
SESSION_EPOCH=change-me-32-lowercase-hex
R_API_TOKEN=change-me-64-lowercase-hex
POSTGRES_PASSWORD=change-me-independent-password
POSTGRES_USER=traceomics_demo
POSTGRES_DB=traceomics_demo

# Use this syntactically valid placeholder only during the three bootstrap
# commands. Replace it with the exact project ID printed by finalize before
# starting the public web service.
DEMO_TEMPLATE_PROJECT_ID=proj_bootstrap_pending
DEMO_GUEST_TTL_SECONDS=3600
SESSION_TTL_SECONDS=3600
APP_DEPLOYMENT_MODE=demo
EXPERT_R_ENABLED=false

APP_IMAGE=traceomics:demo-arm64
OPS_IMAGE=traceomics-operations:demo-arm64
R_IMAGE=traceomics-r:demo-arm64
NAMESPACE_IMAGE=alpine:3.21
POSTGRES_IMAGE=postgres:16-alpine
CADDY_IMAGE=caddy:2.11.4-alpine

BACKUP_HOST_PATH=/srv/traceomics-demo-backups
APP_UID=10001
APP_GID=10001

# The final limits are fixed by compose.demo-free-tier.yml. These variables are
# retained for base-file interpolation and must not be raised on a 12-GB host.
POSTGRES_MEMORY_LIMIT=768m
POSTGRES_CPU_LIMIT=0.30
POSTGRES_SHM_SIZE=128m
R_MEMORY_LIMIT=2g
R_CPU_LIMIT=0.35
R_COMPUTE_MEMORY_LIMIT=2560m
R_COMPUTE_CPU_LIMIT=0.65
R_COMPUTE_SESSION_BYTES=1610612736
R_COMPUTE_SESSION_BYTES_PER_JOB=1073741824
WEB_MEMORY_LIMIT=512m
WEB_CPU_LIMIT=0.25
WORKER_MEMORY_LIMIT=384m
WORKER_CPU_LIMIT=0.25
OPS_MEMORY_LIMIT=512m
OPS_CPU_LIMIT=0.25
JOB_WORKER_MIN_FREE_MEMORY_MB=256

R_MAX_ACTIVE_SESSIONS=4
R_MAX_ACTIVE_SESSIONS_PER_USER=1
R_MAX_ACTIVE_SESSION_BYTES=1610612736
R_MAX_ACTIVE_SESSION_BYTES_PER_USER=805306368
R_MAX_ACTIVE_SESSION_BYTES_PER_SESSION=805306368

EXPERT_R_SANDBOX_TOKEN=disabled
EXPERT_R_SANDBOX_IMAGE=disabled
EXPERT_R_SANDBOX_HOST_WORK_ROOT=/var/lib/traceomics-demo-expert-disabled
EXPERT_R_MEMORY_LIMIT=1g
EXPERT_R_CPU_LIMIT=0.25
EXPERT_R_TIMEOUT_MS=600000
