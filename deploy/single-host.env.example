# Copy this file outside the repository, restrict it to the deployment operator,
# and pass it with --env-file. Values below are placeholders, not credentials.

# Public ingress. TLS terminates in a same-host reverse proxy which forwards to
# 127.0.0.1:3000 and replaces all incoming Forwarded/X-Forwarded-* headers.
FRONTEND_ORIGIN=https://benchone.example.org
WEB_PORT=3000
TRUST_PROXY_HOPS=1
COOKIE_SAMESITE=Lax

# Generate four independent random values. SESSION_EPOCH is a non-secret
# deployment generation but must still be unique and unpredictable in practice.
# Never reuse one secret for another.
# Secrets: `openssl rand -hex 32`. Epoch: `openssl rand -hex 16`.
SESSION_SECRET=change-me
SESSION_EPOCH=change-me
R_API_TOKEN=change-me
POSTGRES_PASSWORD=change-me
POSTGRES_USER=benchone
POSTGRES_DB=benchone

# Use immutable, reviewed image digests for a release deployment. These tag
# defaults are convenient for the first local build only.
APP_IMAGE=scrna-seq-workbench:single-host
OPS_IMAGE=scrna-seq-operations:single-host
R_IMAGE=scrna-seq-r:single-host
NAMESPACE_IMAGE=alpine:3.21
POSTGRES_IMAGE=postgres:16-alpine

# Required absolute host directory on separate durable media. The operations
# container writes backup packages here as APP_UID:APP_GID.
BACKUP_HOST_PATH=/srv/benchone-backups

# The default unprivileged container identity. Ensure BACKUP_HOST_PATH is owned
# by this identity before an operation.
APP_UID=10001
APP_GID=10001

# Conservative starting limits. Measure real datasets before changing these.
POSTGRES_MEMORY_LIMIT=4g
POSTGRES_CPU_LIMIT=2
POSTGRES_SHM_SIZE=1g
R_MEMORY_LIMIT=16g
R_CPU_LIMIT=4
WEB_MEMORY_LIMIT=2g
WEB_CPU_LIMIT=2
WORKER_MEMORY_LIMIT=2g
WORKER_CPU_LIMIT=2
OPS_MEMORY_LIMIT=2g
OPS_CPU_LIMIT=2
JOB_WORKER_MIN_FREE_MEMORY_MB=1024

# Private live-R budgets are admission/eviction limits, not OS memory limits.
R_MAX_ACTIVE_SESSIONS=8
R_MAX_ACTIVE_SESSIONS_PER_USER=4
R_MAX_ACTIVE_SESSION_BYTES=4294967296
R_MAX_ACTIVE_SESSION_BYTES_PER_USER=2147483648
R_MAX_ACTIVE_SESSION_BYTES_PER_SESSION=1073741824
