# Copy to an operator-owned deploy/demo.env. Never reuse private-deployment
# database, session, R, volume, backup, or storage credentials.
APP_DEPLOYMENT_MODE=demo
DEMO_TEMPLATE_PROJECT_ID=proj_replace_with_reviewed_template
DEMO_GUEST_TTL_SECONDS=7200
SESSION_TTL_SECONDS=7200
EXPERT_R_ENABLED=false

# All mandatory production variables from single-host.env.example remain
# required, with demo-only generated values and an HTTPS origin.
FRONTEND_ORIGIN=https://demo.example.org
WEB_PORT=3001
