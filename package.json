{
  "name": "traceomics",
  "version": "1.0.0",
  "description": "TraceOmics: collaborative, provenance-first transcriptomic analysis with React, Express, Postgres, R, and Seurat",
  "author": {
    "name": "TraceOmics"
  },
  "homepage": "https://github.com/IsaacJYPan/scrna-seq",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22.15.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev-runtime.js",
    "dev:no-worker": "concurrently \"npm run vite\" \"node server.js\"",
    "vite": "vite",
    "build": "vite build",
    "start": "node server.js",
    "desktop": "electron .",
    "desktop:package": "npm run build && electron-builder --config electron-builder.config.cjs --dir -c.forceCodeSigning=false",
    "desktop:dist": "npm run build && electron-builder --config electron-builder.config.cjs --publish never",
    "desktop:dist:unsigned": "npm run build && electron-builder --config electron-builder.config.cjs --publish never -c.forceCodeSigning=false",
    "worker": "node --require ./scripts/enable-job-worker.cjs worker.js",
    "worker:once": "node --require ./scripts/enable-job-worker.cjs worker.js --once",
    "pipeline:pack": "node scripts/pack-pipeline.mjs",
    "workflow:pack": "node scripts/pack-workflow.mjs",
    "platform-developer": "node scripts/manage-platform-developer.js",
    "expert-r-access": "node scripts/manage-expert-r-access.js",
    "expert-r:restore-environment": "node scripts/restore-r-environment.js",
    "account-admin": "node scripts/account-admin.js",
    "ops:backup": "node scripts/backup-runtime.js",
    "ops:restore": "node scripts/restore-runtime.js",
    "demo:cleanup": "node scripts/cleanup-demo-guests.js",
    "demo:configure": "node scripts/configure-demo.js",
    "ops:verify-restore": "node scripts/verify-backup-restore.js",
    "test:unit": "node scripts/run_unit_tests.js",
    "test:integration": "npm run test:backend && npm run test:r-state-proxy",
    "test:tutorial": "node scripts/test_pbmc3k_tutorial.js",
    "test:r-state-proxy": "node scripts/verify_r_state_proxy.js",
    "test:seurat-pipeline": "node scripts/verify_seurat_pipeline.js",
    "test:seurat-multisample": "node scripts/verify_multi_sample_seurat_pipeline.js",
    "test:spatial-seurat": "Rscript scripts/verify_spatial_seurat_pipeline.R",
    "test:deg-worker-pipeline": "node scripts/verify_deg_worker_pipeline.js",
    "test:pbmc-parent": "Rscript scripts/verify_pbmc_parent_unmutated.R",
    "test:checkpoint-load": "Rscript scripts/verify_checkpoint_load.R",
    "test:deg-markers": "Rscript scripts/verify_deg_find_markers.R",
    "test:enrichment-gsea": "Rscript scripts/verify_enrichment_gsea.R",
    "test:cellchat-inference": "Rscript scripts/verify_cellchat_inference.R",
    "test:cellchat-receipt-interop": "node scripts/verify_cellchat_receipt_interop.js",
    "test:cellchat-worker-pipeline": "node scripts/verify_cellchat_worker_pipeline.js",
    "test:cellchat-browser": "node scripts/verify_cellchat_browser_flow.js",
    "test:r-storage": "Rscript r-backend/tests/test_storage_paths.R",
    "test:r-public-bounds": "Rscript r-backend/tests/test_public_endpoint_bounds.R",
    "test:r-live-revisions": "Rscript r-backend/tests/test_live_revisions.R",
    "test:r-restored-reductions": "Rscript r-backend/tests/test_restored_reductions.R",
    "test:r-expert-starter": "Rscript r-backend/tests/test_expert_starter.R",
    "test:r-execution-order": "Rscript r-backend/tests/test_execution_order.R",
    "test:backup-restore": "vitest run backend/backup-restore.test.js --environment node --fileParallelism=false",
    "test:backup-restore:real": "node scripts/verify-backup-restore-drill.js",
    "test:deployment:smoke": "node scripts/verify-deployment-smoke.js",
    "test:deployment:browser": "npm run build && node scripts/verify-browser-deployment-flow.js",
    "test:deployment:compose": "node scripts/verify-compose-topology.js",
    "test:deployment:compose-runtime": "node scripts/verify-compose-operations-drill.js",
    "test:private-compute-compose": "node scripts/verify-compose-private-compute.js",
    "test:native-ui-compose": "node scripts/verify-compose-native-ui.js",
    "test:expert-r-sandbox": "node scripts/verify-expert-r-sandbox.js",
    "test:expert-r-browser": "npm run build && node scripts/verify-expert-r-browser-flow.js",
    "test:private-r-kernel": "node scripts/verify-private-r-kernel.js",
    "test:private-r-console-browser": "npm run build && node scripts/verify-private-r-console-ui.js",
    "test:runtime-readiness-browser": "npm run build && node scripts/verify-runtime-readiness-ui.js",
    "test:large-r-artifacts-browser": "npm run build && node scripts/verify-large-r-artifacts-ui.js",
    "test:large-r-artifacts": "node scripts/verify-large-r-artifacts.js",
    "test:demo-compose": "node scripts/verify-compose-demo.js",
    "test:demo-browser": "node scripts/verify-guided-demo-ui.js",
    "test:frontend": "vitest run src/",
    "test:tools": "vitest run scripts/ --environment node --fileParallelism=false",
    "test:desktop": "vitest run desktop/ backend/desktop-packaging.test.js --environment node --fileParallelism=false",
    "test:desktop:targets-ui": "node scripts/verify-desktop-targets-ui.js",
    "test:desktop:ssh-ui": "node scripts/verify-desktop-ssh-ui.js",
    "test:desktop:bastion-ui": "node scripts/verify-desktop-bastion-ui.js",
    "test:desktop:tunnel-ui": "node scripts/verify-desktop-tunnel-ui.js",
    "test:remote-compute-browser": "npm run build && node scripts/verify-remote-compute-ui.js",
    "test:runtime-monitor-browser": "npm run build && node scripts/verify-remote-compute-ui.js",
    "test:server-data-import-browser": "npm run build && node scripts/verify-server-data-import-ui.js",
    "test:artifact-versions-browser": "node scripts/verify-artifact-versions-ui.js",
    "test:execution-history-browser": "node scripts/verify-execution-history-ui.js",
    "test:backend": "npm run test:backend:postgres",
    "test:backend:postgres": "vitest run backend/ --environment node --fileParallelism=false",
    "init:postgres": "node scripts/init-postgres.js",
    "test:visual": "node scripts/test_visual_ux.js",
    "test:visual:smoke": "node scripts/test_visual_ux.js --no-snapshots",
    "test:ui-interactions": "node scripts/verify-ui-interactions.js",
    "test:workbench-ui": "node scripts/verify-workbench-ui.js",
    "test:visual:db-flow": "node scripts/test_db_backed_object_flow.js",
    "test:visual:update": "node scripts/test_visual_ux.js --update-snapshots",
    "test": "npm run test:frontend && npm run test:unit && npm run test:integration",
    "lint": "eslint .",
    "check": "npm run test:backend && npm run test:frontend && npm run lint && npm run build",
    "check:ci-preflight": "node scripts/require-test-database.js && npm audit --audit-level=high && npm run lint && npm run test:deployment:compose && npm run test:frontend && npm run build && npm run test:backend && npm run test:tools && npm run test:desktop",
    "check:browser-preflight": "node scripts/require-test-database.js && npm run build && npm run test:plots && npm run test:cellchat-browser && node scripts/verify-browser-deployment-flow.js",
    "test:plots": "node scripts/verify-plot-rendering.js"
  },
  "dependencies": {
    "@xyflow/react": "^12.10.2",
    "buffer": "^6.0.3",
    "cors": "^2.8.6",
    "dagre": "^0.8.5",
    "express": "^5.2.1",
    "httpxy": "^0.5.5",
    "lucide-react": "^1.0.1",
    "multer": "^2.4.0",
    "pg": "^8.22.0",
    "plotly.js": "3.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-plotly.js": "^2.6.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^9.39.4",
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.1.0",
    "electron": "^43.7.9",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.60.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.2.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.7",
    "wait-on": "^8.0.0"
  },
  "overrides": {
    "maplibre-gl": "^6.9.0",
    "concurrently": {
      "shell-quote": "^1.12.0"
    },
    "minimatch@3": {
      "brace-expansion": "^1.1.21"
    }
  }
}
