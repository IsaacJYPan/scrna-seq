{
  "name": "scrna-seq-workbench",
  "version": "1.0.0",
  "description": "Web-based scRNA-seq analysis platform: React/Vite frontend, Express API, Postgres, and an R Plumber/Seurat backend",
  "main": "server.js",
  "engines": {
    "node": ">=22.15.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev-runtime.js",
    "dev:no-worker": "concurrently \"npm run vite\" \"node server.js\"",
    "vite": "vite",
    "build": "vite build",
    "start": "node server.js",
    "worker": "node --require ./scripts/enable-job-worker.cjs worker.js",
    "worker:once": "node --require ./scripts/enable-job-worker.cjs worker.js --once",
    "platform-developer": "node scripts/manage-platform-developer.js",
    "account-admin": "node scripts/account-admin.js",
    "ops:backup": "node scripts/backup-runtime.js",
    "ops:restore": "node scripts/restore-runtime.js",
    "ops:verify-restore": "node scripts/verify-backup-restore.js",
    "test:unit": "node scripts/run_unit_tests.js",
    "test:integration": "node scripts/run_integration_tests.js",
    "test:tutorial": "node scripts/test_pbmc3k_tutorial.js",
    "test:r-state-proxy": "node scripts/verify_r_state_proxy.js",
    "test:seurat-pipeline": "node scripts/verify_seurat_pipeline.js",
    "test:deg-worker-pipeline": "node scripts/verify_deg_worker_pipeline.js",
    "test:pbmc-parent": "Rscript scripts/verify_pbmc_parent_unmutated.R",
    "test:checkpoint-load": "Rscript scripts/verify_checkpoint_load.R",
    "test:deg-markers": "Rscript scripts/verify_deg_find_markers.R",
    "test:enrichment-gsea": "Rscript scripts/verify_enrichment_gsea.R",
    "test:r-storage": "Rscript r-backend/tests/test_storage_paths.R",
    "test:r-public-bounds": "Rscript r-backend/tests/test_public_endpoint_bounds.R",
    "test:backup-restore": "vitest run backend/backup-restore.test.js --environment node --fileParallelism=false",
    "test:backup-restore:real": "node scripts/verify-backup-restore-drill.js",
    "test:deployment:smoke": "node scripts/verify-deployment-smoke.js",
    "test:deployment:browser": "npm run build && node scripts/verify-browser-deployment-flow.js",
    "test:deployment:compose": "node scripts/verify-compose-topology.js",
    "test:deployment:compose-runtime": "node scripts/verify-compose-operations-drill.js",
    "test:frontend": "vitest run src/",
    "test:backend": "npm run test:backend:postgres",
    "test:backend:postgres": "vitest run backend/ --environment node --fileParallelism=false",
    "init:postgres": "node scripts/init-postgres.js",
    "test:visual": "node scripts/test_visual_ux.js",
    "test:visual:db-flow": "node scripts/test_db_backed_object_flow.js",
    "test:visual:update": "node scripts/test_visual_ux.js --update-snapshots",
    "test": "npm run test:backend && npm run test:frontend && npm run test:unit && npm run test:integration && npm run test:tutorial && npm run test:r-state-proxy",
    "lint": "eslint .",
    "check": "npm run test:backend && npm run test:frontend && npm run lint && npm run build"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@xyflow/react": "^12.10.2",
    "cors": "^2.8.6",
    "dagre": "^0.8.5",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.0.0",
    "lucide-react": "^1.0.1",
    "multer": "^2.1.1",
    "pg": "^8.22.0",
    "plotly.js-dist-min": "^3.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-plotly.js": "^2.6.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.7",
    "wait-on": "^8.0.0"
  }
}
