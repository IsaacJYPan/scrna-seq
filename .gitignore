# Dependencies
node_modules/

# Markdown documentation policy
# Track the public root README plus the curated docs/ tree. Development/spec/agent
# and current-state handoff markdown still belongs in ignored local context such
# as .project/codex/. Generated guides under docs/guide/ stay ignored (see below).
*.md
!/README.md
!/docs/**/*.md

# Build output
dist/

# R
r-backend/.Rhistory
r-backend/.RData
r-backend/*.Rout

# Data — never commit raw sequencing data or large binary matrices
data/
*.h5
*.h5ad
*.h5seurat
*.mtx
*.mtx.gz
*.loom

# Electron
out/

# Logs
*.log
npm-debug.log*

# Environment
.env
.env.local

# OS
.DS_Store
Thumbs.db

# Local assistant/tool settings
.claude/
/AGENTS.md
/WORKFLOW.md

# Vite
.vite/

# R session objects — RDS files are large user-specific binary blobs
r-backend/sessions/
r-backend/vault/
# Runtime per-user vault (uploaded data files, R state, project dataset storage)
vault/
*.rds
*.RDS
*.meta.json

# SQLite database files (results cache, user auth) — user-specific
*.sqlite
*.db

# R library cache
r-backend/renv/

# Generated exports — SVG/PDF plot files produced at runtime
exports/

# Playwright test artifacts — screenshots, reports (regeneratable)
playwright/report/
# Reviewed visual regression baselines under playwright/snapshots are versioned.
playwright-report/
test-results/

# Local Codex/debug run artifacts: logs, screenshots, PID files, scratch probes
.codex-run/

# Scratch / temporary R scripts — one-off debugging files
scratch/

# Generated reference metrics — produced by generate_reference_pbmc3k.R
scripts/reference_metrics.json

# npm lock file — large, frequently changes, regeneratable with `npm install`
# Uncomment the next line only if you intentionally omit lock files
# package-lock.json

# Large token-expensive generated files
visual_test.js

# Generated Guides (Beginner Full-Stack Course)
docs/guide/

.project/

.playwright-mcp*
