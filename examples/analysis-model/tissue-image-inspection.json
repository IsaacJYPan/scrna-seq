{
  "caseId": "tissue-image-inspection",
  "illustrative": true,
  "description": "Full-resolution image stays an input reference. A bounded preview retains its physical coordinate transform; the human selection creates an annotation artifact with evidence.",
  "recipe": {
    "format": "traceomics-workflow",
    "schemaVersion": 2,
    "id": "lab.tissue-inspection",
    "name": "Tissue inspection",
    "version": "1.0.0",
    "description": "Bounded preview followed by an explicit human decision; no full image is embedded in the recipe.",
    "inputs": {
      "image": {
        "type": "image",
        "cardinality": "one",
        "format": {
          "id": "org.ome.tiff",
          "version": "1",
          "metadata": {
            "org.ome:coordinate-unit": "micrometer"
          }
        }
      }
    },
    "outputs": {},
    "environments": {
      "image": {
        "profileId": "image-preview-v1",
        "runtime": {
          "language": "tool"
        },
        "version": "1",
        "digest": "ec8e4e4b6354fc4c679de0bb115d85318f3f8dd81f0bb81afd879ab7b12854f6"
      }
    },
    "files": {
      "tools/preview.json": "{\"maximumWidth\":1024,\"retainCoordinateTransform\":true}"
    },
    "steps": [
      {
        "id": "preview-image",
        "label": "Inspect tissue preview",
        "operation": {
          "kind": "tool",
          "adapter": "image-preview-v1",
          "entry": "tools/preview.json",
          "helpers": [],
          "arguments": [
            "--max-width",
            "1024"
          ]
        },
        "inputs": {
          "image": {
            "type": "image",
            "cardinality": "one",
            "format": {
              "id": "org.ome.tiff",
              "version": "1",
              "metadata": {
                "org.ome:coordinate-unit": "micrometer"
              }
            }
          }
        },
        "bindings": {
          "image": {
            "kind": "input",
            "port": "image"
          }
        },
        "outputs": {
          "preview": {
            "type": "image",
            "cardinality": "one",
            "format": {
              "id": "org.w3.png",
              "version": "1"
            }
          }
        },
        "parameters": {},
        "environment": "image",
        "ui": {
          "results": [
            "preview"
          ]
        }
      },
      {
        "id": "mark-region",
        "label": "Record inspected region",
        "operation": {
          "kind": "human",
          "action": "region-selection",
          "instructions": "Record polygon coordinates in source image units, scale transform, and inspection notes."
        },
        "inputs": {
          "image": {
            "type": "image",
            "cardinality": "one",
            "format": {
              "id": "org.ome.tiff",
              "version": "1",
              "metadata": {
                "org.ome:coordinate-unit": "micrometer"
              }
            }
          },
          "preview": {
            "type": "image",
            "cardinality": "one",
            "format": {
              "id": "org.w3.png",
              "version": "1"
            }
          }
        },
        "bindings": {
          "image": {
            "kind": "input",
            "port": "image"
          },
          "preview": {
            "kind": "step",
            "step": "preview-image",
            "port": "preview"
          }
        },
        "outputs": {
          "region": {
            "type": "annotation",
            "cardinality": "one",
            "format": {
              "id": "org.traceomics.image-annotation",
              "version": "1"
            }
          }
        },
        "parameters": {},
        "environment": null,
        "ui": {
          "results": [
            "region"
          ]
        }
      }
    ]
  },
