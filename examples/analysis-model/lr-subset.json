{
  "caseId": "lr-subset",
  "illustrative": true,
  "description": "Named LR pairs are selected from a versioned candidate table. An empty pair list explicitly retains all pairs; downstream results reference the saved subset and exact criteria.",
  "recipe": {
    "format": "traceomics-workflow",
    "schemaVersion": 2,
    "id": "lab.lr-subset",
    "name": "Select LR pairs",
    "version": "1.0.0",
    "description": "Illustrative analysis contract; this record does not certify an installed scientific executor.",
    "inputs": {
      "candidates": {
        "type": "table",
        "cardinality": "one",
        "format": {
          "id": "org.traceomics.lr-candidates",
          "version": "1"
        }
      },
      "design": {
        "type": "design",
        "cardinality": "one",
        "format": {
          "id": "org.traceomics.experimental-design",
          "version": "1"
        },
        "optional": true
      }
    },
    "outputs": {},
    "environments": {
      "research": {
        "profileId": "scrna-r-4.5-bioconductor-3.22-v1",
        "version": "1",
        "digest": "f6baa2a2bec09b0934bf9452dd88d10ead6db6b694c7ede7242a3392c4a1540e",
        "runtime": {
          "language": "r",
          "version": "4.5.1"
        },
        "lockfile": "environment/renv.lock"
      }
    },
    "files": {
      "environment/renv.lock": "{\"R\":{\"Version\":\"4.5.1\"},\"Packages\":{}}",
      "steps/select-pairs.R": "pairs <- params$pairs\ncandidates <- inputs$candidates\nif (length(pairs) == 0) selected <- candidates else {\n  wanted <- vapply(pairs, function(pair) paste(pair$ligand, pair$receptor, sep = \"\\\\r\"), character(1))\n  selected <- candidates[paste(candidates$ligand, candidates$receptor, sep = \"\\\\r\") %in% wanted, , drop = FALSE]\n}\nwrite_output(\"selected\", selected)\nwrite_output(\"counts\", list(retained = nrow(selected), excluded = nrow(candidates) - nrow(selected)))"
    },
    "steps": [
      {
        "id": "select-pairs",
        "label": "select-pairs",
        "operation": {
          "kind": "r",
          "entry": "steps/select-pairs.R",
          "helpers": [],
          "state": "isolated"
        },
        "inputs": {
          "candidates": {
            "type": "table",
            "cardinality": "one",
            "format": {
              "id": "org.traceomics.lr-candidates",
              "version": "1"
            }
          },
          "design": {
            "type": "design",
            "cardinality": "one",
            "format": {
              "id": "org.traceomics.experimental-design",
              "version": "1"
            },
            "optional": true
          }
        },
        "bindings": {
          "candidates": {
            "kind": "input",
            "port": "candidates"
          },
          "design": {
            "kind": "input",
            "port": "design"
          }
        },
        "outputs": {
          "selected": {
            "type": "table",
            "cardinality": "one",
            "format": {
              "id": "org.traceomics.lr-candidates",
              "version": "1"
            }
          },
          "counts": {
            "type": "metrics",
            "cardinality": "one",
            "format": {
              "id": "org.traceomics.metrics",
              "version": "1"
            }
          }
        },
        "parameters": {
          "pairs": {
            "type": "pair-list",
            "label": "Ligand receptor pairs",
            "default": [],
            "empty": "all",
            "maxItems": 200,
            "input": "candidates"
          }
        },
        "environment": "research",
        "ui": {
          "label": "select-pairs",
          "results": [
            "selected",
            "counts"
          ]
        }
      }
    ],
