{
  "caseId": "zero-filter-edit",
  "illustrative": true,
  "description": "A recipe fork inserts an explicit zero-score rule. The input table is preserved; the selected table and retained/excluded metrics are new versions.",
  "recipe": {
    "format": "traceomics-workflow",
    "schemaVersion": 2,
    "id": "lab.zero-filter",
    "name": "Explicit zero filter",
    "version": "1.0.0",
    "description": "Illustrative analysis contract; this record does not certify an installed scientific executor.",
    "inputs": {
      "scores": {
        "type": "table",
        "cardinality": "one",
        "format": {
          "id": "org.traceomics.table",
          "version": "1"
        }
      }
    },
    "outputs": {},
    "environments": {
      "research": {
        "profileId": "scrna-r-4.5-bioconductor-3.22-v1",
        "version": "1",
        "digest": "f6baa2a2bec09b0934bf9452dd88d10ead6db6b694c7ede7242a3392c4a1540e",
        "runtime": {
          "language": "r",
          "version": "4.5.1"
        },
        "lockfile": "environment/renv.lock"
      }
    },
    "files": {
      "environment/renv.lock": "{\"R\":{\"Version\":\"4.5.1\"},\"Packages\":{}}",
      "steps/drop-zeroes.R": "values <- inputs$scores\nkeep <- rowSums(values[c(\"score_a\", \"score_b\")] == 0) == 0\nwrite_output(\"selected\", values[keep, , drop = FALSE])\nwrite_output(\"counts\", list(retained = sum(keep), excluded = sum(!keep)))"
    },
    "steps": [
      {
        "id": "drop-zeroes",
        "label": "drop-zeroes",
        "operation": {
          "kind": "r",
          "entry": "steps/drop-zeroes.R",
          "helpers": [],
          "state": "isolated"
        },
        "inputs": {
          "scores": {
            "type": "table",
            "cardinality": "one",
            "format": {
              "id": "org.traceomics.table",
              "version": "1"
            }
          }
        },
        "bindings": {
          "scores": {
            "kind": "input",
            "port": "scores"
          }
        },
        "outputs": {
          "selected": {
            "type": "table",
            "cardinality": "one",
            "format": {
              "id": "org.traceomics.table",
              "version": "1"
            }
          },
          "counts": {
            "type": "metrics",
            "cardinality": "one",
            "format": {
              "id": "org.traceomics.metrics",
              "version": "1"
            }
          }
        },
        "parameters": {
          "rule": {
            "type": "choice",
            "label": "Zero rule",
            "options": [
              "either-score-zero"
            ],
            "default": "either-score-zero"
          }
        },
        "environment": "research",
        "ui": {
          "label": "drop-zeroes",
          "results": [
            "selected",
            "counts"
          ]
        }
      }
    ],
    "package": {
