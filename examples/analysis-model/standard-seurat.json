{
  "caseId": "standard-seurat",
  "illustrative": true,
  "description": "Existing QC, normalization, PCA, independent neighbors/clustering and UMAP branches; every output has a new immutable identity.",
  "recipe": {
    "format": "traceomics-workflow",
    "schemaVersion": 2,
    "id": "scrna-workflow",
    "name": "Single-cell workflow",
    "version": "1.0.0",
    "description": "QC, normalization, PCA, independent neighbors and UMAP branches, and custom R figures.",
    "inputs": {
      "analysis": {
        "type": "object",
        "cardinality": "one",
        "format": {
          "id": "org.r-project.rds",
          "version": "1"
        },
        "label": "Saved analysis"
      }
    },
    "outputs": {},
    "environments": {
      "legacy": {
        "profileId": "scrna-r-4.5-bioconductor-3.22-v1",
        "runtime": {
          "language": "r"
        }
      }
    },
    "files": {
      "steps/qc.R": "analysis <- inputs$analysis\nanalysis[[\"percent.mt\"]] <- PercentageFeatureSet(analysis, pattern = \"^MT-\")\nkeep <- analysis$nFeature_RNA >= params[[\"min-features\"]] &\n  analysis$percent.mt <= params[[\"max-mito\"]]\nif (!any(keep)) stop(\"No cells match these filters\")\nanalysis <- subset(analysis, cells = colnames(analysis)[keep])\nwrite_output(\"analysis\", analysis)\nwrite_output(\"summary\", list(cells = ncol(analysis), features = nrow(analysis)))\ncounts <- data.frame(features = analysis$nFeature_RNA)\nwrite_output(\"distribution\", ggplot2::ggplot(counts, ggplot2::aes(x = features)) +\n  ggplot2::geom_histogram(bins = 30, fill = \"#1685e8\") + ggplot2::theme_minimal())\n",
      "steps/normalize.R": "analysis <- NormalizeData(inputs$analysis, verbose = FALSE)\nanalysis <- FindVariableFeatures(analysis, nfeatures = min(params$features, nrow(analysis)), verbose = FALSE)\nanalysis <- ScaleData(analysis, verbose = FALSE)\nwrite_output(\"analysis\", analysis)\n",
      "steps/pca.R": "analysis <- RunPCA(inputs$analysis, npcs = min(params$components, ncol(inputs$analysis) - 1L,\n  length(VariableFeatures(inputs$analysis)) - 1L), seed.use = seed, verbose = FALSE)\nwrite_output(\"analysis\", analysis)\nwrite_output(\"elbow\", ElbowPlot(analysis))\n",
      "steps/neighbors.R": "analysis <- inputs$analysis\ndimensions <- seq_len(min(params$dimensions, ncol(Embeddings(analysis, \"pca\"))))\nanalysis <- FindNeighbors(analysis, dims = dimensions, verbose = FALSE)\nwrite_output(\"analysis\", analysis)\n",
      "steps/clusters.R": "analysis <- FindClusters(inputs$analysis, resolution = params$resolution, random.seed = seed, verbose = FALSE)\nwrite_output(\"labels\", data.frame(cell = colnames(analysis), cluster = as.character(Idents(analysis))))\n",
      "steps/umap.R": "analysis <- inputs$analysis\ndimensions <- seq_len(min(params$dimensions, ncol(Embeddings(analysis, \"pca\"))))\nanalysis <- RunUMAP(analysis, dims = dimensions, n.neighbors = min(params$neighbors, ncol(analysis) - 1L), seed.use = seed, verbose = FALSE)\ncoordinates <- Embeddings(analysis, \"umap\")\nwrite_output(\"coordinates\", list(x = unname(coordinates[, 1]), y = unname(coordinates[, 2]), ids = rownames(coordinates)))\n",
      "steps/umap-figure.R": "coordinates <- inputs$coordinates\nlabels <- inputs$labels\nif (anyDuplicated(labels$cell) || !setequal(coordinates$ids, labels$cell)) stop(\"Cell identities differ\")\nmatched <- match(coordinates$ids, labels$cell)\npoints <- data.frame(x = coordinates$x, y = coordinates$y, cluster = labels$cluster[matched])\nwrite_output(\"figure\", ggplot2::ggplot(points, ggplot2::aes(x = x, y = y, color = cluster)) +\n  ggplot2::geom_point(size = params[[\"point-size\"]]) + ggplot2::theme_minimal())\n"
    },
