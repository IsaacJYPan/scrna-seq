# ── Frontend (Vite) ─────────────────────────────────────────────────────
# Frontend API base URL, read at build time by Vite as import.meta.env.VITE_API_BASE_URL.
# Leave empty for a same-origin deployment (Express serves the built frontend and the API).
# Set to an absolute origin (e.g. https://api.example.com) when the API is on a different host.
# A trailing slash is tolerated and stripped.
VITE_API_BASE_URL=

# ── Node environment ─────────────────────────────────────────────────────
# development (default) | production. Production enables the config validation
# gate (server refuses to start on a missing secret/DB/origin or non-Secure
# cookies) and makes session cookies Secure by default.
NODE_ENV=development

# ── Database backend (Postgres required) ──────────────────────────────────
# Postgres is required for the app runtime.
# SQLite is no longer a runtime option.
# Set DATABASE_URL or PG* variables below before starting the server.
# See docs/architecture.md → "Database backend".
DATABASE_BACKEND=postgres

# Postgres connection. Set DATABASE_URL for a hosted/CI database, OR the discrete
# PG* vars below. Initialize the schema with `npm run init:postgres`.
# DATABASE_URL=postgres://user:password@localhost:5432/scrna
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=scrna
# PGSSLMODE=verify-full  # required for non-loopback production Postgres
# PG_POOL_MAX=10
# PG_CONNECT_TIMEOUT_MS=5000
# PG_IDLE_TIMEOUT_MS=30000
# `require` without certificate verification is development compatibility only
# and is rejected in production.

# ── Backend / session ───────────────────────────────────────────────────
# HMAC signing secret for cookie-only session tokens. REQUIRED in production as
# exactly 64 lowercase hexadecimal characters generated by
# `openssl rand -hex 32`; obvious repeated/sequential values are rejected. The
# validator checks encoding and degeneracy, while the operator remains
# responsible for using a cryptographically secure generator. In development,
# an ephemeral secret is generated per process.
SESSION_SECRET=change-me

# Non-secret 16-byte deployment generation (`openssl rand -hex 16`). It is
# embedded in sessions; keep it stable for routine restarts and replace it for
# every disaster-recovery candidate so pre-restore cookies cannot resurrect.
# REQUIRED in production.
SESSION_EPOCH=change-me

# Session lifetime in seconds (default: 43200 = 12h). Also the cookie Max-Age.
SESSION_TTL_SECONDS=43200

# ── Cookie auth (HttpOnly session cookie) ─────────────────────────────────
# The browser session is an HttpOnly cookie. Bearer authentication is rejected,
# old localStorage credentials are purged, and logout revokes every outstanding
# session for the account through a database-backed session version.
# COOKIE_SECURE: true|false. Defaults to Secure in production, non-Secure in dev.
# Setting it to false in production makes the server refuse to start.
# COOKIE_SECURE=true
# COOKIE_SAMESITE: Lax (default) | Strict | None. Lax + the origin check below
# is the CSRF strategy for cookie-authenticated state-changing requests.
# Use None only when the frontend and API are on different sites and cookies
# must be sent cross-site; it requires COOKIE_SECURE=true and HTTPS browser
# origins in production.
# COOKIE_SAMESITE=Lax

# ── Networking / ports ──────────────────────────────────────────────────
# Express server port (default 3000).
PORT=3000

# Listener address. Production accepts only 127.0.0.1, ::1, or 0.0.0.0. The
# supported Compose topology uses 0.0.0.0 inside the shared private namespace,
# while the only host mapping remains 127.0.0.1.
WEB_HOST=127.0.0.1

# Exact trusted reverse-proxy hop count (1-3). REQUIRED in production. The proxy
# must replace incoming Forwarded/X-Forwarded-* headers and mark HTTPS requests.
# Direct non-health production HTTP requests are rejected.
TRUST_PROXY_HOPS=1

# Web shutdown marks readiness 503, waits this drain delay, closes/awaits HTTP,
# then releases R/topology/DB resources within the overall shutdown budget.
WEB_DRAIN_DELAY_MS=1000
WEB_SHUTDOWN_TIMEOUT_MS=150000

# Web GET /livez is dependency-free liveness. GET /readyz requires Postgres,
# writable STORAGE_ROOT/VAULT_ROOT, and the singleton web lock. R unavailability
# is reported as computeDegraded without taking metadata readiness down.

# Local R Plumber backend port (default 8000).
PLUMBER_PORT=8000

# Allowed browser origin(s) for CORS AND the cookie-auth CSRF origin check.
# Comma-separated; trailing slashes are stripped. FRONTEND_ORIGIN is preferred;
# FRONTEND_URL is the legacy name and is still honored. In a same-origin
# deployment this must include the app's own origin so cookie-auth POSTs pass the
# CSRF check. For cross-site cookie deployments (COOKIE_SAMESITE=None), every
# production origin here must be https://. REQUIRED in production.
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Login and development signup have separate per-IP process-local rate limits;
# expensive password work also has a small global admission queue. Production
# network signup is always disabled and accounts use `npm run account-admin`.
# Malformed values fall back safely. DISABLE_RATE_LIMIT is test-only and has no
# effect in production.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# R runtime ownership: `owned` makes the web process spawn a loopback R child;
# `external` connects the web process to a separately managed private R service.
# The standalone worker always requires external mode so it and the web proxy use
# the same process-local live-R state. Do not expose the R service to browsers.
R_RUNTIME_MODE=owned

# Dedicated internal R service credential. Required (32+ characters) in
# production and for `npm run worker`; do not reuse SESSION_SECRET or DB/cloud
# credentials. The R process receives this as API_TOKEN through a narrow env.
# `npm run dev` generates an ephemeral shared token when this is unset.
# R_API_TOKEN=replace-with-at-least-32-random-characters

# Private R base URL. Defaults to loopback + PLUMBER_PORT. Non-IP internal DNS
# names must also be listed exactly in R_BACKEND_ALLOWED_HOSTS. Production
# non-loopback services must use HTTPS because this connection carries a reusable
# R capability and biological data.
# R_BACKEND_URL=http://127.0.0.1:8000
# R_BACKEND_ALLOWED_HOSTS=r-compute.internal
# Set this only when a reviewed service mesh encrypts the HTTP hop below the app
# layer; ordinary private-network HTTP is not sufficient.
# R_BACKEND_ALLOW_INSECURE_PRIVATE_HTTP=false

# Authenticated legacy live-R compatibility proxy. Production uses an exact
# reviewed method/path allowlist, one shared-R request at a time, a 120s maximum
# connection deadline, and an 8 MiB response cap. Values must be positive
# integers; production validation rejects concurrency >1, timeouts >120000, and
# response caps >8388608 for the supported single-R topology. Legacy synchronous
# 10X/H5 vault loaders, CSV metadata inspection/mutation, and vault-writing subset are
# development-only until they become bounded durable jobs.
# Synchronous batch integration is development-only until it has an isolated
# durable job because a timed-out CCA run cannot be terminated in shared R.
R_PROXY_TIMEOUT_MS=120000
R_PROXY_MAX_RESPONSE_BYTES=8388608
R_PROXY_RATE_LIMIT_WINDOW_MS=60000
R_PROXY_RATE_LIMIT_MAX=60
R_PROXY_MAX_CONCURRENT=1

# Process-local live R objects are private per user/object and intentionally
# bounded. The single R process evicts least-recently-used sessions before these
# global/per-user count or estimated object-size budgets can be exceeded.
R_MAX_ACTIVE_SESSIONS=8
R_MAX_ACTIVE_SESSIONS_PER_USER=4
R_MAX_ACTIVE_SESSION_BYTES=4294967296
R_MAX_ACTIVE_SESSION_BYTES_PER_USER=2147483648
R_MAX_ACTIVE_SESSION_BYTES_PER_SESSION=1073741824

# ── Storage roots (server-only; never returned in API responses) ──────────
# STORAGE_ROOT holds new project-scoped datasets, checkpoints, and result files.
# It also contains temporary upload staging. Defaults to ./data. VAULT_ROOT holds
# private live-session data and legacy durable records. Defaults to ./vault. In
# production these must be separate, persistent, server-only directories shared
# with the R process. Neither root is exposed through API responses.
# Production requires explicit, separate, non-overlapping absolute paths.
# STORAGE_ROOT=/srv/benchone/data
# VAULT_ROOT=/srv/benchone/vault

# ── Standalone job worker ────────────────────────────────────────────────
# ONLY the exact string "true" enables `worker.js`; any other value is disabled.
# The web server no longer starts the worker. `npm run worker` sets this flag for
# the standalone process; `npm run dev` supervises Vite + web + worker with one
# shared private R runtime. `npm run dev:no-worker` starts only Vite + web + R.
ENABLE_JOB_WORKER=false

# Worker poll interval between idle ticks, in ms. Must be a positive integer;
# invalid/blank/zero/negative/non-integer values fall back to the default (1000)
# with a warning.
JOB_WORKER_POLL_MS=1000

# Worker claim lease length, in seconds. Must be an integer of at least 10;
# invalid/shorter values fall back to the default (120) with a warning. Ten
# seconds is only the mechanical floor, not a deployment recommendation. Real R compute jobs (Seurat
# pipeline, DEG, checkpoint load) run tens of seconds to minutes; the worker renews
# the lease while an R call is in flight, and this is the safety floor for the
# pre-handler window, so keep it generous.
JOB_WORKER_LEASE_SECONDS=120

# Hard process policy: one in-flight job per worker. Values other than 1 fail
# startup. A session advisory lock refuses a second standalone replica, and a
# separate transaction advisory gate prevents more than one unexpired live claim;
# run only one heavy worker process in the supported v1 topology.
JOB_WORKER_CONCURRENCY=1

# Admission reservation, not a hard OS/container RAM cap. The worker pauses before
# claiming when process-available memory is below this threshold. Tune from measured
# dataset sizes; still enforce real container/VM limits at deployment time.
JOB_WORKER_MIN_FREE_MEMORY_MB=1024

# Optional comma-separated registered capability subset. Unset means the worker
# preserves the normal all-job-types policy (including terminal failure of known but
# unimplemented types). Use only for reviewed topology-specific worker pools.
# JOB_WORKER_ALLOWED_JOB_TYPES=seurat.pipeline.v1

# Private process health endpoint: GET /livez and GET /readyz. Loopback by default;
# use 0.0.0.0 only inside a private container network and never publish it publicly.
JOB_WORKER_HEALTH_HOST=127.0.0.1
JOB_WORKER_HEALTH_PORT=3101

# Startup waits for Postgres, authenticated R, shared-storage proof, and memory.
JOB_WORKER_STARTUP_TIMEOUT_MS=30000

# Graceful drain budget. The default (630s) exceeds the current maximum 600s R
# bridge call plus finalization margin. Orchestrator termination grace must exceed it.
JOB_WORKER_DRAIN_TIMEOUT_MS=630000

# ── Trusted local RDS loading ────────────────────────────────────────────
# Fail-closed. RDS deserialization can execute arbitrary R code, so the public
# /api/r/load-rds and /api/r/restore-session paths are blocked unless this is
# exactly "true" outside production. Production always blocks them. Enable only
# for trusted local/dev inputs; uploaded RDS files are not safe for untrusted
# users until stronger sandbox/container isolation exists.
ALLOW_TRUSTED_RDS_LOAD=false

# ── Uploads ─────────────────────────────────────────────────────────────
# Maximum size of a single uploaded file in bytes (default 536870912 = 512 MiB).
# In production, set only positive integer values.
MAX_UPLOAD_BYTES=536870912

# Maximum number of files accepted in a single directory upload (default 10000).
# In production, set only positive integer values. Legacy vault file/directory
# uploads are disabled; project dataset uploads remain writer-role gated. This
# single-host topology assumes trusted provisioned users and does not implement
# per-user durable byte quotas, so enforce host/filesystem capacity alerts.
MAX_UPLOAD_FILES=10000
