# ── Frontend (Vite) ─────────────────────────────────────────────────────
# Frontend API base URL, read at build time by Vite as import.meta.env.VITE_API_BASE_URL.
# Leave empty for a same-origin deployment (Express serves the built frontend and the API).
# Set to an absolute origin (e.g. https://api.example.com) when the API is on a different host.
# A trailing slash is tolerated and stripped.
VITE_API_BASE_URL=

# ── Node environment ─────────────────────────────────────────────────────
# development (default) | production. Production enables the config validation
# gate (server refuses to start on a missing secret/DB/origin or non-Secure
# cookies) and makes session cookies Secure by default.
NODE_ENV=development

# ── Database backend (SQLite local/test → Postgres hosted) ────────────────
# Backend selection: sqlite | postgres. If unset, Postgres is inferred when
# DATABASE_URL is present, else SQLite. SQLite remains the current runtime; the
# Postgres path (backend/pgDatabase.js + backend/pg/schema.sql) is the
# hosted-service foundation. See docs/architecture.md → "Database backend".
DATABASE_BACKEND=sqlite

# Postgres connection. Set DATABASE_URL for a hosted/CI database, OR the discrete
# PG* vars below. Initialize the schema with `npm run init:postgres`.
# DATABASE_URL=postgres://user:password@localhost:5432/scrna
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=scrna
# PGSSLMODE=require   # enable TLS for a hosted provider (never for local/CI)

# ── Backend / session ───────────────────────────────────────────────────
# HMAC signing secret for session tokens (bearer AND HttpOnly cookie share it).
# REQUIRED in production (NODE_ENV=production), otherwise the server refuses to
# start. In dev, an ephemeral secret is generated per process.
SESSION_SECRET=change-me

# Session lifetime in seconds (default: 43200 = 12h). Also the cookie Max-Age.
SESSION_TTL_SECONDS=43200

# ── Cookie auth (HttpOnly session cookie) ─────────────────────────────────
# The browser session is an HttpOnly cookie; the localStorage bearer token is
# deprecated legacy/dev compatibility (see docs/architecture.md → auth).
# COOKIE_SECURE: true|false. Defaults to Secure in production, non-Secure in dev.
# Setting it to false in production makes the server refuse to start.
# COOKIE_SECURE=true
# COOKIE_SAMESITE: Lax (default) | Strict | None. Lax + the origin check below
# is the CSRF strategy for cookie-authenticated state-changing requests.
# COOKIE_SAMESITE=Lax

# ── Networking / ports ──────────────────────────────────────────────────
# Express server port (default 3000).
PORT=3000

# Local R Plumber backend port (default 8000).
PLUMBER_PORT=8000

# Allowed browser origin(s) for CORS AND the cookie-auth CSRF origin check.
# Comma-separated; trailing slashes are stripped. FRONTEND_ORIGIN is preferred;
# FRONTEND_URL is the legacy name and is still honored. In a same-origin
# deployment this must include the app's own origin so cookie-auth POSTs pass the
# CSRF check. REQUIRED in production.
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Internal R Plumber backend base URL (server-only; NEVER exposed to the client).
# Defaults to http://127.0.0.1:${PLUMBER_PORT}. Override for a containerized R
# backend. Do not point browsers at this.
# R_BACKEND_URL=http://127.0.0.1:8000

# ── Storage roots (server-only; never returned in API responses) ──────────
# STORAGE_ROOT: durable data root (SQLite db, uploads, project-scoped durable
# resources). Defaults to ./data. VAULT_ROOT: per-user private vault for
# transient live-R state. Defaults to ./vault.
# STORAGE_ROOT=./data
# VAULT_ROOT=./vault

# ── Job worker (minimal drain loop) ─────────────────────────────────────
# Opt-in. ONLY the exact string "true" enables the worker; any other value
# ("TRUE", "1", "yes", blank, unset, …) leaves it disabled. When enabled, server
# startup runs the worker drain loop that claims queued jobs and runs ONLY the
# registered, allowlisted handlers. These now include REAL scientific/R work, not
# just a noop: `generic` (noop), `checkpoint.noop` (metadata-only), `r.runtime.check`
# and `r.object.inspect` (read-only R inspection), `pbmc.pipeline.v1` (runs the
# Seurat preprocessing pipeline on a copy of the input object and writes a checkpoint
# RDS), `checkpoint.load.v1` (mutates the owner's live R session), and
# `deg.find_markers.v1` (runs DEG/FindAllMarkers). Every other job type is failed as
# UNSUPPORTED_JOB_TYPE. Enabling the worker therefore lets queued jobs execute R
# computation against owned live objects — keep it disabled unless you intend that.
# Disabled by default so local/dev and tests stay worker-free unless explicitly enabled.
ENABLE_JOB_WORKER=false

# Worker poll interval between idle ticks, in ms. Must be a positive integer;
# invalid/blank/zero/negative/non-integer values fall back to the default (1000)
# with a warning.
JOB_WORKER_POLL_MS=1000

# Worker claim lease length, in seconds. Must be a positive integer; invalid
# values fall back to the default (30) with a warning.
JOB_WORKER_LEASE_SECONDS=30

# ── Trusted local RDS loading ────────────────────────────────────────────
# Fail-closed. RDS deserialization can execute arbitrary R code, so the public
# /api/r/load-rds path is blocked unless this is exactly "true". Enable only for
# trusted local/dev inputs; uploaded RDS files are not safe for untrusted users
# until stronger sandbox/container isolation exists.
ALLOW_TRUSTED_RDS_LOAD=false

# ── Uploads ─────────────────────────────────────────────────────────────
# Maximum size of a single uploaded file in bytes (default 536870912 = 512 MiB).
MAX_UPLOAD_BYTES=536870912

# Maximum number of files accepted in a single directory upload (default 10000).
MAX_UPLOAD_FILES=10000
