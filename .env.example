# ── Frontend (Vite) ─────────────────────────────────────────────────────
# Frontend API base URL, read at build time by Vite as import.meta.env.VITE_API_BASE_URL.
# Leave empty for a same-origin deployment (Express serves the built frontend and the API).
# Set to an absolute origin (e.g. https://api.example.com) when the API is on a different host.
# A trailing slash is tolerated and stripped.
VITE_API_BASE_URL=

# ── Backend / session ───────────────────────────────────────────────────
# HMAC signing secret for session tokens. REQUIRED in production (NODE_ENV=production),
# otherwise the server refuses to start. In dev, an ephemeral secret is generated per process.
SESSION_SECRET=change-me

# Session lifetime in seconds (default: 43200 = 12h).
SESSION_TTL_SECONDS=43200

# ── Networking / ports ──────────────────────────────────────────────────
# Express server port (default 3000).
PORT=3000

# Local R Plumber backend port (default 8000).
PLUMBER_PORT=8000

# CORS: the frontend origin allowed by the Express backend (default http://localhost:5173).
FRONTEND_URL=http://localhost:5173

# ── Job worker (minimal drain loop) ─────────────────────────────────────
# Opt-in. ONLY the exact string "true" enables the worker; any other value
# ("TRUE", "1", "yes", blank, unset, …) leaves it disabled. When enabled, server
# startup runs the worker drain loop that claims queued jobs and runs ONLY the
# registered, allowlisted handlers. These now include REAL scientific/R work, not
# just a noop: `generic` (noop), `checkpoint.noop` (metadata-only), `r.runtime.check`
# and `r.object.inspect` (read-only R inspection), `pbmc.pipeline.v1` (runs the
# Seurat preprocessing pipeline on a copy of the input object and writes a checkpoint
# RDS), `checkpoint.load.v1` (mutates the owner's live R session), and
# `deg.find_markers.v1` (runs DEG/FindAllMarkers). Every other job type is failed as
# UNSUPPORTED_JOB_TYPE. Enabling the worker therefore lets queued jobs execute R
# computation against owned live objects — keep it disabled unless you intend that.
# Disabled by default so local/dev and tests stay worker-free unless explicitly enabled.
ENABLE_JOB_WORKER=false

# Worker poll interval between idle ticks, in ms. Must be a positive integer;
# invalid/blank/zero/negative/non-integer values fall back to the default (1000)
# with a warning.
JOB_WORKER_POLL_MS=1000

# Worker claim lease length, in seconds. Must be a positive integer; invalid
# values fall back to the default (30) with a warning.
JOB_WORKER_LEASE_SECONDS=30

# ── Uploads ─────────────────────────────────────────────────────────────
# Maximum size of a single uploaded file in bytes (default 536870912 = 512 MiB).
MAX_UPLOAD_BYTES=536870912

# Maximum number of files accepted in a single directory upload (default 10000).
MAX_UPLOAD_FILES=10000
